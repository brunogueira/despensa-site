---
// Tópicos em linhas finas (sem cartão), cada um com um check de traço em SVG: nunca o caractere "✓", que muda de cara em cada aparelho.
// Os textos chegam prontos (quem chama cuida das palavras curtas no fim da linha).
interface Props { itens: readonly string[]; class?: string }
const { itens, class: cls } = Astro.props;
---
<ul class:list={['topicos', cls]}>
  {itens.map((t) => (
    <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
      <span>{t}</span>
    </li>
  ))}
</ul>
