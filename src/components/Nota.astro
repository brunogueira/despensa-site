---
// A nota fiscal da LP: papel térmico com borda serrilhada, linhas em mono, marca-texto no preço lido e a tarja no CPF.
// É ilustração, com dados de exemplo (os mesmos das telas do app). O CPF nunca aparece: só uma máscara sem dígitos, coberta pela tarja.
// Duas versões:
// - a do hero (padrão): o feixe do leitor varre a nota e cada linha reage quando ele passa (M3 a M5 de docs/lp-premium/proposta.md);
// - trecho: só o pedaço da nota em volta do CPF, para a privacidade. A tarja cobre o CPF quando o trecho aparece (M10).
// O estado-base é o final (marcas, checks e tarja já no lugar); o movimento só existe com prefers-reduced-motion: no-preference.
// Com JS, o movimento espera a nota aparecer (60% dela na tela): no celular ela começa abaixo da dobra.
import Glyph from './Glyph.astro';

interface Props { class?: string; trecho?: boolean }
const { class: cls = '', trecho = false } = Astro.props;

const itens = [
  ['Leite integral 1L', '37,80'],
  ['Requeijão light 400g', '29,90'],
  ['Pão de forma 500g', '23,74'],
  ['Molho de tomate 680g', '26,58'],
];
const rotulo = trecho
  ? 'Trecho de nota fiscal de exemplo: o CPF é coberto por uma tarja, com a indicação de descartado'
  : 'Nota fiscal de exemplo sendo lida: itens com preço e o CPF coberto por uma tarja, com a indicação de descartado';
---
<div class:list={['receipt', trecho ? 'receipt--trecho' : 'lendo', cls]}>
  <div class="rshadow" aria-hidden="true"></div>
  <div class="paper" role="img" aria-label={rotulo}>
    {!trecho && <div class="beam-box" aria-hidden="true"><div class="beam"></div></div>}
    <div class="hd" aria-hidden="true">
      {trecho
        ? <div><b>Nota fiscal eletrônica</b><small>NFC-e · trecho de exemplo</small></div>
        : <Fragment><Glyph /><div><b>Supermercado Central</b><small>11/10/2026 · dados de exemplo</small></div></Fragment>}
    </div>
    <div aria-hidden="true">
      {trecho ? (
        <Fragment>
          <div class="sum"><span>Total pago</span><span>400,08</span></div>
          <div class="sum"><span>Pagamento</span><span>Cartão de crédito</span></div>
        </Fragment>
      ) : (
        <Fragment>
          {itens.map(([nome, preco]) => (
            <div class="r" data-hit>
              <svg class="ck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              <span>{nome}</span><span class="dl"></span><b class="pr"><span class="mk"></span>{preco}</b>
            </div>
          ))}
          <div class="more">+ 8 produtos</div>
          <div class="sum"><span>Subtotal</span><span>406,08</span></div>
          <div class="sum"><span>Desconto</span><span>- 6,00</span></div>
        </Fragment>
      )}
      <div class="cpf" data-hit><span class="lb">CPF</span><span class="val"><s>···.···.···-··</s><i class="tarja"></i></span><span class="ds">Descartado</span></div>
      {trecho
        ? <div class="sum"><span>Itens lidos</span><span>12</span></div>
        : <div class="tot" data-hit><span>Total pago</span><b class="pr"><span class="mk"></span>R$ 400,08</b></div>}
    </div>
  </div>
</div>
<script is:inline>
  // Hero: quando o feixe "lê" cada linha, a posição real dela na nota (0 a 1) vira --hit, que atrasa a marca, o check e a tarja.
  // Mede uma vez (o papel tem largura fixa e fonte do sistema). O trecho da privacidade não tem feixe: nada a medir.
  // Sem movimento, nada a medir nem a esperar.
  // O movimento fica pausado (CSS: .js .lendo:not(.ver) e .js .receipt--trecho:not(.ver)) até 60% da nota aparecer.
  // Hero já visível na carga: segue a coreografia; se aparecer pela rolagem, o feixe começa logo (--t0 de 250 ms).
  (function (s) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var r = s.previousElementSibling, carga = true;
    if (r.classList.contains('lendo')) {
      var p = r.querySelector('.paper'), h = p.offsetHeight;
      p.querySelectorAll('[data-hit]').forEach(function (el) {
        var y = el.offsetHeight / 2, n = el;
        while (n && n !== p) { y += n.offsetTop; n = n.offsetParent; }
        el.style.setProperty('--hit', Math.min(1, y / h).toFixed(3));
      });
    }
    if (!('IntersectionObserver' in window)) { r.classList.add('ver'); return; }
    var io = new IntersectionObserver(function (es) {
      if (es[0].intersectionRatio >= .59) {
        if (!carga) r.style.setProperty('--t0', '250ms');
        r.classList.add('ver');
        io.disconnect();
      }
      carga = false;
    }, { threshold: .6 });
    io.observe(r);
  })(document.currentScript);
</script>
