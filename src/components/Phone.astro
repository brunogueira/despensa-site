---
// Moldura de celular com uma captura real do app (Tela.astro).
// platform: 'ios' ou 'android' (moldura mais reta e furo da câmera, desenho próprio).
// O <slot> recebe camadas por cima da tela (ex.: .sobre com o feixe do leitor no passo 2 do "Como funciona").
import Tela from './Tela.astro';

interface Props { nome: string; alt: string; platform?: 'ios' | 'android'; crop?: boolean; eager?: boolean; class?: string; sizes?: string }
const { nome, alt, platform = 'ios', crop = false, eager = false, class: cls = '', sizes } = Astro.props;
---
<div class:list={['phone', platform === 'android' && 'phone--android', crop && 'phone--crop', cls]}>
  <Tela nome={nome} alt={alt} platform={platform} eager={eager} sizes={sizes} />
  <slot />
</div>
