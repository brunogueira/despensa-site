---
import '../styles/global.css';
import Glyph from '../components/Glyph.astro';
// italico: a página usa o itálico da Fraunces logo no começo (a palavra-chave do h1) e vale baixá-lo junto com o normal.
interface Props { title: string; description: string; path?: string; noindex?: boolean; jsonLd?: object; italico?: boolean }
const { title, description, path = '/', noindex = false, jsonLd, italico = false } = Astro.props;
const site = 'https://despensa.online';
const url = new URL(path, site).href;
const og = `${site}/og.png`;
const email = 'despensa.lista@gmail.com';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Fonte dos títulos, do próprio site. O itálico só tem preload onde aparece na primeira dobra (italico); nas outras páginas
         só baixa se aparecer. crossorigin é obrigatório no preload de fonte. -->
    <link rel="preload" href="/fonts/fraunces-500-latin.woff2" as="font" type="font/woff2" crossorigin />
    {italico && <link rel="preload" href="/fonts/fraunces-400-italic-latin.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191712" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Tema escolhido no botão (claro ou escuro), aplicado antes da pintura para não piscar. Sem escolha: segue o aparelho.
      (function () {
        var t = null;
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') return;
        document.documentElement.setAttribute('data-theme', t);
        document.querySelector('meta[name="color-scheme"]').setAttribute('content', t);
        var cor = t === 'dark' ? '#191712' : '#f3f1ec';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', cor); });
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Despensa" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Despensa: rolo de nota fiscal com um check verde" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Despensa, página inicial"><Glyph /> Despensa</a>
        <div class="top-acoes">
          <nav class="main" aria-label="Principal">
            <a class="hide-sm" href="/#como-funciona">Como funciona</a>
            <a class="hide-sm" href="/#recursos">Recursos</a>
            <a href="/planos">Planos</a>
          </nav>
          <button type="button" class="tema-btn" id="tema-btn" data-tema="auto" aria-label="Tema: automático, segue o aparelho. Mudar para claro" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <g class="i-auto"><rect x="3.5" y="4.5" width="17" height="11.5" rx="2"/><path d="M9 20h6M12 16v4"/></g>
              <g class="i-claro"><circle cx="12" cy="12" r="4"/><path d="M12 3v1.5M12 19.5V21M5.6 5.6l1.1 1.1M17.3 17.3l1.1 1.1M3 12h1.5M19.5 12H21M5.6 18.4l1.1-1.1M17.3 6.7l1.1-1.1"/></g>
              <g class="i-escuro"><path d="M19.5 14.2A7.5 7.5 0 0 1 9.8 4.5a7.5 7.5 0 1 0 9.7 9.7z"/></g>
            </svg>
          </button>
          <script is:inline>
            // Botão de tema: automático → claro → escuro → automático. Sem JS ele fica escondido e a página segue o aparelho.
            (function () {
              var b = document.getElementById('tema-btn');
              var d = document.documentElement;
              var nomes = { auto: 'automático, segue o aparelho', light: 'claro', dark: 'escuro' };
              var proximo = { auto: 'light', light: 'dark', dark: 'auto' };
              var acao = { auto: 'Mudar para automático', light: 'Mudar para claro', dark: 'Mudar para escuro' };
              var cores = { light: '#f3f1ec', dark: '#191712' };
              function aplicar(t) {
                var metas = document.querySelectorAll('meta[name="theme-color"]');
                if (t === 'auto') {
                  d.removeAttribute('data-theme');
                  document.querySelector('meta[name="color-scheme"]').setAttribute('content', 'light dark');
                  metas.forEach(function (m) { m.setAttribute('content', /dark/.test(m.media) ? cores.dark : cores.light); });
                } else {
                  d.setAttribute('data-theme', t);
                  document.querySelector('meta[name="color-scheme"]').setAttribute('content', t);
                  metas.forEach(function (m) { m.setAttribute('content', cores[t]); });
                }
                b.setAttribute('data-tema', t);
                b.setAttribute('aria-label', 'Tema: ' + nomes[t] + '. ' + acao[proximo[t]]);
                b.title = 'Tema: ' + nomes[t];
              }
              var atual = d.getAttribute('data-theme') || 'auto';
              aplicar(atual);
              b.hidden = false;
              b.addEventListener('click', function () {
                atual = proximo[atual];
                aplicar(atual);
                try { if (atual === 'auto') localStorage.removeItem('tema'); else localStorage.setItem('tema', atual); } catch (e) {}
              });
            })();
          </script>
        </div>
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site">
      <div class="wrap foot">
        <div>
          <a class="brand" href="/" aria-label="Despensa, página inicial"><Glyph /> Despensa</a>
          <p class="muted" style="margin:6px 0 0;max-width:30ch">Lista de compras da casa que lê a nota fiscal.</p>
          <p class="muted small foot-copy">© 2026 Despensa. Feito em São Paulo.</p>
        </div>
        <nav aria-label="Produto">
          <h2 class="foot-h">Produto</h2>
          <ul>
            <li><a href="/#como-funciona">Como funciona</a></li>
            <li><a href="/#recursos">Recursos</a></li>
            <li><a href="/planos">Planos</a></li>
            <li><a href="/#perguntas">Perguntas</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal">
          <h2 class="foot-h">Legal</h2>
          <ul>
            <li><a href="/termos">Termos de uso</a></li>
            <li><a href="/privacidade">Política de Privacidade</a></li>
            <li><a href={`mailto:${email}`}>Fale com a gente</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script is:inline>
      // "Dispara quando aparece", o único da página: o movimento de [data-aparece] fica pausado no CSS (.js ...:not(.ver)) até o
      // alvo aparecer, e aí ganha .ver uma vez. data-aparece: fração do alvo à vista (0 a 1); data-alvo: seletor de um filho a observar
      // (sem ele, o próprio elemento); data-margem: rootMargin. Se apareceu pela rolagem (e não já na carga), ganha também .tarde.
      // Sem movimento, nada a esperar: tudo já está no estado final. Sem IntersectionObserver, roda logo.
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll('[data-aparece]').forEach(function (el) {
          if (!('IntersectionObserver' in window)) { el.classList.add('ver'); return; }
          var limiar = +el.dataset.aparece, alvo = el.dataset.alvo ? el.querySelector(el.dataset.alvo) : el, carga = true;
          var io = new IntersectionObserver(function (es) {
            if (es[0].isIntersecting && es[0].intersectionRatio >= limiar - .01) {
              if (!carga) el.classList.add('tarde');
              el.classList.add('ver');
              io.disconnect();
            }
            carga = false;
          }, { threshold: limiar, rootMargin: el.dataset.margem || '0px' });
          io.observe(alvo);
        });
      })();
    </script>
  </body>
</html>
