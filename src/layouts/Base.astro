---
import '../styles/global.css';
import Glyph from '../components/Glyph.astro';
interface Props { title: string; description: string; path?: string; noindex?: boolean; jsonLd?: object }
const { title, description, path = '/', noindex = false, jsonLd } = Astro.props;
const site = 'https://despensa.brunocnog.com.br';
const url = new URL(path, site).href;
const og = `${site}/og.png`;
const email = 'despensa.lista@gmail.com';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191712" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Despensa" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Despensa: rolo de nota fiscal com um check verde" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Despensa, página inicial"><Glyph /> Despensa</a>
        <nav class="main" aria-label="Principal">
          <a class="hide-sm" href="/#como-funciona">Como funciona</a>
          <a class="hide-sm" href="/#recursos">Recursos</a>
          <a href="/planos">Planos</a>
          <a href="/#perguntas">Perguntas</a>
        </nav>
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site">
      <div class="wrap foot">
        <div>
          <a class="brand" href="/" aria-label="Despensa, página inicial"><Glyph /> Despensa</a>
          <p class="muted" style="margin:6px 0 0;max-width:30ch">Lista de compras da casa que lê a nota fiscal.</p>
          <p class="muted small foot-copy">© 2026 Despensa. Feito em São Paulo.</p>
        </div>
        <nav aria-label="Produto">
          <h2 class="foot-h">Produto</h2>
          <ul>
            <li><a href="/#como-funciona">Como funciona</a></li>
            <li><a href="/#recursos">Recursos</a></li>
            <li><a href="/planos">Planos</a></li>
            <li><a href="/#perguntas">Perguntas</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal">
          <h2 class="foot-h">Legal</h2>
          <ul>
            <li><a href="/termos">Termos de uso</a></li>
            <li><a href="/privacidade">Política de Privacidade</a></li>
            <li><a href={`mailto:${email}`}>Fale com a gente</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
