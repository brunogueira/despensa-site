---
import Base from '../layouts/Base.astro';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Despensa',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'LifestyleApplication',
  description: 'A lista da casa que aprende os preços sozinha. Escaneie a nota fiscal do mercado e a Despensa preenche a compra.',
  url: 'https://despensa.brunocnog.com.br/',
  inLanguage: 'pt-BR',
};

const passos = [
  { t: 'A lista da casa', d: 'Todo mundo que mora junto vê a mesma lista. Quem passa no mercado marca o que já pegou, e o resto da casa vê na hora.', i: 'M4 6h16M4 12h16M4 18h10' },
  { t: 'Leia a nota fiscal', d: 'No caixa, aponte a câmera para o QR da nota (NFC-e). A Despensa lê os itens e os preços e preenche a compra. Você só confere.', i: 'M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M8 12h8' },
  { t: 'Veja os preços', d: 'Cada nota alimenta o histórico. Você vê se o arroz subiu, quanto custa o quilo e em qual mercado cada item sai mais barato.', i: 'M4 18l5-6 4 3 7-9' },
  { t: 'Compartilhe uma lista', d: 'Precisa de ajuda numa compra? Convide uma pessoa só para aquela lista, para ver ou para editar. Ela não vê o resto da casa.', i: 'M12 4v11M8 8l4-4 4 4M5 14v5h14v-5' },
];
const itens = [
  { t: 'Nunca guardamos o CPF.', d: 'O CPF que aparece na nota fiscal é descartado. Ele não fica no seu iPhone, na nuvem nem em registros técnicos.' },
  { t: 'Funciona sem internet.', d: 'Seus dados ficam primeiro no seu aparelho.' },
  { t: 'Sem anúncios e sem venda de dados.', d: 'Não rastreamos você entre apps.' },
  { t: 'Você manda.', d: 'Pode pedir seus dados, corrigir e apagar a conta e tudo que está nela.' },
];
---
<Base
  title="Despensa: a lista da casa que aprende os preços sozinha"
  description="Escaneie a nota fiscal do mercado e a Despensa preenche a compra, guarda os preços e mostra onde cada item sai mais barato. App para iPhone, com Android a caminho."
  jsonLd={ld}
>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>A lista da casa que aprende os preços sozinha.</h1>
        <p class="sub">Escaneie a nota fiscal do mercado e a Despensa preenche a compra, guarda os preços e mostra onde cada item sai mais barato.</p>
        <div class="actions">
          <button type="button" class="btn lg" aria-disabled="true" aria-describedby="hero-nota">Em breve na App Store</button>
          <p class="muted small note" id="hero-nota">Estamos terminando os últimos detalhes.</p>
        </div>
        <p><a class="alt" href="#como-funciona">Ver como funciona</a></p>
        <p class="muted small">Para iPhone, com Android a caminho. Leitura de notas de São Paulo e Rio de Janeiro.</p>
      </div>
      <!-- TODO(UX): trocar esta ilustração por capturas reais do app (dados fictícios, sem CPF nem mercado real). -->
      <div class="phone" role="img" aria-label="Ilustração da lista da casa no app, com itens marcados e preços de exemplo">
        <div class="screen" aria-hidden="true">
          <h3>Lista da casa</h3>
          <div class="row done"><span class="dot"></span>Arroz 5 kg <span class="price">R$ 28,90</span></div>
          <div class="row done"><span class="dot"></span>Feijão <span class="price">R$ 8,49</span></div>
          <div class="row"><span class="dot"></span>Café <span class="price">R$ 19,90</span></div>
          <div class="row"><span class="dot"></span>Leite integral</div>
          <div class="row"><span class="dot"></span>Sabão em pó</div>
          <div class="tag">Arroz: mais barato no mercado A</div>
        </div>
      </div>
    </div>
  </section>

  <section id="como-funciona" class="band">
    <div class="wrap">
      <h2 class="center">Como funciona</h2>
      <ol class="steps">
        {passos.map((p) => (
          <li>
            <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.i} /></svg></div>
            <h3>{p.t}</h3>
            <p class="muted" style="margin:0">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <h2>Quanto você pagou, quanto custa agora.</h2>
        <p>A Despensa junta os preços de todas as suas notas. Você enxerga a tendência de cada produto, compara mercados e sabe se vale esperar a promoção.</p>
        <p class="muted small">Hoje lemos notas fiscais eletrônicas (NFC-e) de São Paulo e do Rio de Janeiro. Outros estados vêm depois.</p>
      </div>
      <!-- TODO(UX): trocar por captura real da tela Preços. Valores abaixo são fictícios. -->
      <div class="chart">
        <table>
          <caption>Arroz 5 kg (exemplo)</caption>
          <thead><tr><th scope="col">Mercado</th><th scope="col">Preço</th></tr></thead>
          <tbody>
            <tr><td>Mercado A</td><td>R$ 26,90</td></tr>
            <tr><td>Mercado B</td><td>R$ 28,90</td></tr>
            <tr><td>Mercado C</td><td>R$ 31,50</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="privacy" id="privacidade-resumo">
    <div class="wrap">
      <h2 class="center">Seus dados são seus.</h2>
      <ul>
        {itens.map((i) => <li><strong>{i.t}</strong>{i.d}</li>)}
      </ul>
      <p class="center"><a href="/privacidade">Ler a Política de Privacidade</a></p>
    </div>
  </section>

  <section id="planos">
    <div class="wrap">
      <h2 class="center">Comece de graça</h2>
      <!-- TODO(Bruno/PM): detalhar o que entra em cada versão e se o valor é pagamento único ou assinatura. Até lá, texto neutro. -->
      <div class="plans">
        <div class="plan">
          <h3>Grátis para começar</h3>
          <p class="muted" style="margin:0">Baixe e comece a usar sem pagar nada.</p>
        </div>
        <div class="plan full">
          <h3>Plano completo, em breve</h3>
          <p class="muted" style="margin:0">Histórico de preços completo, comparação entre mercados com gráficos, mais casas e mais listas. Os valores serão divulgados no lançamento.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap faq">
      <h2>Perguntas rápidas</h2>
      <details><summary>Funciona no Android?</summary><p>Em breve. Hoje a Despensa é para iPhone, e a versão Android está em testes.</p></details>
      <details><summary>Quais notas o app lê?</summary><p>Notas fiscais eletrônicas (NFC-e) de São Paulo e do Rio de Janeiro. Outros estados vêm depois.</p></details>
      <details><summary>Preciso de conta?</summary><p>Para sincronizar com a casa e convidar pessoas, sim: entre com a sua conta.</p></details>
      <details><summary>Custa algo?</summary><p>Você pode começar de graça. Haverá um plano completo opcional, com os valores divulgados no lançamento.</p></details>
      <details><summary>Quem vê minha lista?</summary><p>Só quem mora na sua casa e as pessoas que você convidar. Convidados veem apenas a lista que você escolheu.</p></details>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Leve a Despensa para o mercado.</h2>
      <p><strong>Em breve na App Store.</strong></p>
      <button type="button" class="btn lg" aria-disabled="true" aria-describedby="cta-nota">Em breve na App Store</button>
      <p class="muted small" id="cta-nota" style="margin-top:10px">Estamos terminando os últimos detalhes.</p>
      <!-- No lançamento: virar link para a App Store e trocar o texto para "Baixe na App Store." -->
    </div>
  </section>
</Base>
