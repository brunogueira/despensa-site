---
import Base from '../layouts/Base.astro';
import Glyph from '../components/Glyph.astro';
import Nota from '../components/Nota.astro';
import Phone from '../components/Phone.astro';
import Tela from '../components/Tela.astro';
import StoreButtons from '../components/StoreButtons.astro';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Despensa',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'LifestyleApplication',
  description: 'Compre melhor. Escaneie a nota, a Despensa guarda os preços. Lista de compras da casa que lê a nota fiscal.',
  url: 'https://despensa.online/',
  inLanguage: 'pt-BR',
};

const ic = {
  lista: 'M4 6h16M4 12h16M4 18h10',
  preco: 'M4 18l5-6 4 3 7-9',
};
// Os três passos do "Como funciona". tela: a captura do passo (src/assets/telas/<aparelho>/<tela>.png), a mesma no iPhone e no Android.
// linha: o trecho da nota que ecoa o print (decorativo, fora da leitura de tela); os valores são os das capturas, todos de exemplo.
const passos = [
  {
    t: 'A lista da casa',
    d: 'Todo mundo que mora junto vê a mesma lista. Quem passa no mercado marca o que já pegou, e o resto da casa vê na hora.',
    linha: ['Mercado da semana', '14 no carrinho'],
    tela: 'lista',
    ios: 'Lista Mercado da semana no iPhone: item em aberto e itens já no carrinho, com o total estimado',
    android: 'Lista Mercado da semana no Android: item em aberto e itens já no carrinho, com o total estimado',
  },
  {
    t: 'Leia a nota fiscal',
    d: 'Aponte a câmera para o QR Code da nota (NFC-e). A Despensa preenche a compra com os itens e os preços, e você só confere.',
    linha: ['Supermercado Central', 'R$ 400,08'],
    tela: 'compra-detalhe',
    ios: 'Compra aberta no iPhone, com a nota já lida: mercado, total, forma de pagamento e itens',
    android: 'Compra aberta no Android, com a nota já lida: mercado, total, forma de pagamento e itens',
  },
  {
    t: 'Veja os preços',
    d: 'Cada nota alimenta o histórico. Você vê se o arroz subiu e em qual mercado cada item sai mais barato.',
    linha: ['Café tradicional 500g', 'menor R$ 21,91'],
    tela: 'precos',
    ios: 'Preço de um produto no iPhone: último, menor e maior preço pagos, média e histórico ao longo do tempo',
    android: 'Preço de um produto no Android: último, menor e maior preço pagos, média e histórico ao longo do tempo',
  },
];
// Palavra curta (artigo, preposição, "e", "é", "ou", "se") fica grudada na seguinte: nenhuma linha dos textos termina com ela sozinha.
// Nome de estado composto também não se parte ("do Rio / de Janeiro").
const cola = (t: string) => t.replace(/Rio de Janeiro|Rio Grande do Sul|São Paulo|Distrito Federal/g, (m) => m.replace(/ /g, '\u00a0')).replace(/(?<=^|\s)([aeoéà]|ou|as|os|ao|da|de|do|em|na|no|se|um|das|dos|nas|nos|nem|com|sem|por)\s/gi, '$1\u00a0').replace('QR Code', 'QR\u00a0Code');
const aparelhos = [
  { id: 'ios', nome: 'iPhone' },
  { id: 'android', nome: 'Android' },
] as const;
// Privacidade: a promessa do CPF é o título (e a demonstração da tarja); as outras ficam em texto, cada uma com um ícone de traço.
const promessas = [
  { t: 'Sem anúncios', d: 'e sem venda de dados.', ic: 'M5 5l14 14M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z' },
  { t: 'Não rastreamos você', d: 'entre apps, nem neste site.', ic: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM9 12l2 2 4-4' },
  { t: 'Funciona sem internet.', d: 'Seus dados ficam primeiro no seu aparelho.', ic: 'M3 9a14 14 0 0 1 18 0M6 12.5a9.5 9.5 0 0 1 12 0M9 16a5 5 0 0 1 6 0M12 19.5h.01M4 4l16 16' },
  { t: 'Apague tudo quando quiser.', d: 'Conta e dados, de uma vez.', ic: 'M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4h6v3' },
];
const perguntas = [
  ['Quais notas o app lê?', 'A NFC-e, a nota do mercado com QR Code. A leitura já foi conferida com notas do Paraná, de Pernambuco, do Rio de Janeiro, do Rio Grande do Sul e de São Paulo. Nos outros estados, o app tenta ler a nota e, se não conseguir, pede uma foto dela. No Distrito Federal, a leitura é sempre por foto.'],
  ['Preciso de conta?', 'Para sincronizar com a casa e convidar pessoas, sim: entre com a sua conta.'],
  ['Custa algo?', null],
  ['Quem vê minha lista?', 'Só quem mora na sua casa e quem você convidar, e convidados veem só a lista escolhida.'],
  ['O CPF da nota fica guardado?', 'Nunca. Ele é descartado na leitura.'],
];
---
<Base
  title="Despensa: compre melhor, a lista de compras da casa que lê a nota fiscal"
  description="Compre melhor. Escaneie a nota, a Despensa guarda os preços e mostra onde cada item sai mais barato. Lista de compras da casa que lê a nota fiscal, para iPhone, com Android a caminho."
  jsonLd={ld}
  italico
>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>
          <span class="ln l1 big"><span>Compre <em>melhor.</em></span></span>{' '}
          <span class="ln l2 rest"><span><b>Escaneie a nota</b>, a Despensa guarda os preços.</span></span>
        </h1>
        <p class="lead fade f1">Lista de compras da casa que lê a nota fiscal.</p>
        <div class="fade f2"><StoreButtons /></div>
        {/* Estados: a versão à vista é curta (siglas); o leitor de tela ouve a frase completa. */}
        <p class="uf fade f3">
          <span aria-hidden="true">
            <span class="uf-k">Leitura conferida: <span class="uf-l"><i>PR</i> · <i>PE</i> · <i>RJ</i> · <i>RS</i> · <i>SP</i></span></span>
            <span class="uf-n">{cola('Nos outros estados, o app tenta ler e, se não der, pede a foto da nota. No DF, é por foto.')}</span>
          </span>
          <span class="sr">Leitura de notas conferida no Paraná, em Pernambuco, no Rio de Janeiro, no Rio Grande do Sul e em São Paulo. Nos outros estados, o app tenta ler a nota e, se não conseguir, pede uma foto dela. No Distrito Federal, a leitura é por foto.</span>
        </p>
      </div>
      <div class="stage-box">
        <div class="stage">
          {/* A nota vem antes no HTML (o leitor de tela lê a nota e depois a lista); o z-index a mantém por cima do celular. */}
          <div class="px px-nota" data-depth="14"><Nota /></div>
          <div class="px px-tel" data-depth="6">
            <Phone nome="lista" alt={passos[0].ios} sizes="(min-width: 561px) 272px, 180px" eager />
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      // M6: nota e celular se deslocam no mesmo sentido, contra o ponteiro, a nota mais (até 7 px) que o celular (até 3 px): profundidade.
      // Suavizado. Só com mouse ou trackpad e com movimento liberado;
      // o laço de quadros só roda enquanto há diferença a percorrer. Posição relativa à janela: nenhuma leitura de layout a cada movimento.
      (function () {
        if (!matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) return;
        var hero = document.currentScript.parentNode, px = hero.querySelectorAll('.px'), tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
        function quadro() {
          cx += (tx - cx) * .08; cy += (ty - cy) * .08;
          px.forEach(function (l) { var k = -l.dataset.depth; l.style.translate = (cx * k).toFixed(2) + 'px ' + (cy * k).toFixed(2) + 'px'; });
          raf = Math.abs(tx - cx) + Math.abs(ty - cy) > .002 ? requestAnimationFrame(quadro) : 0;
        }
        function mira(x, y) { tx = x; ty = y; if (!raf) raf = requestAnimationFrame(quadro); }
        hero.addEventListener('pointermove', function (e) { mira(e.clientX / innerWidth - .5, e.clientY / innerHeight - .5); });
        hero.addEventListener('pointerleave', function () { mira(0, 0); });
      })();
    </script>
  </section>

  <section class="how" id="como-funciona" aria-labelledby="como-h">
    <div class="wrap how-grid">
      <div class="how-head">
        <span class="eyebrow">Como funciona</span>
        <h2 id="como-h">Do mercado para a&nbsp;lista, em&nbsp;<em>três passos.</em></h2>
      </div>
      {/* O palco: o alternador de aparelho e, no desktop, o celular fixo que troca de tela conforme o passo que está no meio da tela (M7, M8).
           Na tela estreita (ou sem JS) só o alternador aparece aqui, e cada passo traz o seu celular. O alternador é CSS puro (:has). */}
      <div class="how-stage">
        <fieldset class="ap">
          <legend class="sr">Aparelho das telas</legend>
          {aparelhos.map((a, i) => (
            <Fragment>
              <input type="radio" name="aparelho" id={`ap-${a.id}`} value={a.id} checked={i === 0} />
              <label for={`ap-${a.id}`}>{a.nome}</label>
            </Fragment>
          ))}
          <span class="ap-thumb" aria-hidden="true"></span>
        </fieldset>
        {/* Uma moldura por aparelho, cada uma com as três telas empilhadas e o feixe do leitor. Fora da leitura de tela: os passos já descrevem as telas. */}
        <div class="palco" data-passo="1" aria-hidden="true">
          {aparelhos.map((a) => (
            <div class:list={['phone', a.id === 'android' && 'phone--android', `so-${a.id}`]}>
              <div class="scr">
                {passos.map((p, i) => (
                  <div class={`s s${i + 1}`}><Tela platform={a.id} nome={p.tela} alt="" sizes="282px" /></div>
                ))}
                <div class="beam-box"><div class="beam"></div></div>
              </div>
            </div>
          ))}
        </div>
        <p class="hint">Telas com dados de exemplo.</p>
      </div>
      <ol class="steps">
        {passos.map((p, i) => (
          <li>
            <span class="dot" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
            {i < passos.length - 1 && <span class="fio" aria-hidden="true"></span>}
            <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.t}</h3>
            <p class="d">{cola(p.d)}</p>
            <p class="line" aria-hidden="true"><span>{p.linha[0]}</span><span class="dl"></span><b>{p.linha[1]}</b></p>
            <div class="inline-phone">
              {aparelhos.map((a) => (
                <Phone platform={a.id} nome={p.tela} alt={p[a.id]} class={`so-${a.id}`}>
                  {i === 1 && <div class="sobre" aria-hidden="true"><div class="beam-box"><div class="beam"></div></div></div>}
                </Phone>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </div>
    <script is:inline>
      // "Como funciona": o passo que contém a linha do meio da tela vira o ativo. Ele decide a tela do celular fixo
      // (data-passo no palco), o fio e os pontos (M9). Funciona também com "reduzir movimento": aí a troca de tela é um fade curto.
      // Sem IntersectionObserver, nada muda: a página fica no layout estreito, um celular por passo.
      (function () {
        var sec = document.currentScript.parentNode, palco = sec.querySelector('.palco');
        var ol = sec.querySelector('.steps'), lis = [].slice.call(ol.children);
        // Aparelho: a escolha vale só nesta sessão (sessionStorage). Sem escolha, quem visita de um Android começa no Android;
        // sem JS (ou se o armazenamento falhar) fica no iPhone.
        var ap = null;
        try { ap = sessionStorage.getItem('aparelho'); } catch (e) {}
        if (!ap && /Android/i.test(navigator.userAgent)) ap = 'android';
        var r0 = ap && document.getElementById('ap-' + ap);
        if (r0) r0.checked = true;
        sec.querySelectorAll('input[name="aparelho"]').forEach(function (r) {
          r.addEventListener('change', function () {
            palco.setAttribute('data-trocou', '');
            try { sessionStorage.setItem('aparelho', r.value); } catch (e) {}
          });
        });
        // Ao chegar no alternador (ponteiro ou foco), baixa as telas do aparelho que não está à mostra, só as do tema e do layout
        // atuais (palco no desktop, um celular por passo no estreito): a moldura não entra vazia na primeira troca.
        var ap0 = sec.querySelector('.ap'), baixou = {};
        function preCarregar() {
          var outro = sec.querySelector('#ap-android').checked ? 'ios' : 'android';
          if (baixou[outro]) return;
          baixou[outro] = true;
          var onde = getComputedStyle(palco).display === 'none' ? '.inline-phone' : '.palco';
          sec.querySelectorAll(onde + ' .so-' + outro + ' img').forEach(function (img) {
            if (getComputedStyle(img).display === 'none') return;
            var i = new Image();
            i.sizes = img.sizes; i.srcset = img.srcset; i.src = img.src;
          });
        }
        ap0.addEventListener('pointerenter', preCarregar);
        ap0.addEventListener('focusin', preCarregar);
        if (!('IntersectionObserver' in window)) return;
        var atual = 0;
        function marcar(n) {
          if (n === atual) return;
          atual = n;
          palco.setAttribute('data-passo', n);
          lis.forEach(function (li, i) { li.classList.toggle('on', i + 1 === n); li.classList.toggle('feito', i + 1 < n); });
        }
        // O passo ativo sai da geometria, não da entrada que o observador avisou: o li que contém o meio da tela. Acima da lista
        // (ela começa abaixo do meio) é o 1; depois dela, o último. Assim a rolagem pode inverter a qualquer hora sem prender o passo.
        function passoNoMeio() {
          var y = innerHeight / 2, r = ol.getBoundingClientRect();
          if (r.top > y) return 1;
          if (r.bottom <= y) return lis.length;
          for (var i = 0; i < lis.length; i++) {
            var b = lis[i].getBoundingClientRect();
            if (b.top <= y && b.bottom > y) return i + 1;
          }
          return atual || 1;
        }
        sec.classList.add('com-js');
        marcar(1);
        // As transições só ligam depois do primeiro quadro: a troca do estado-base (tudo preenchido) para o passo 1 não anima.
        requestAnimationFrame(function () { requestAnimationFrame(function () { sec.classList.add('pronto'); }); });
        // Faixa de altura zero no meio da tela: o observador avisa sempre que a borda de um passo (ou da lista) cruza essa linha.
        var io = new IntersectionObserver(function () { marcar(passoNoMeio()); }, { rootMargin: '-50% 0px -50% 0px' });
        io.observe(ol);
        lis.forEach(function (li) { io.observe(li); });
        // Tela estreita: o feixe varre a tela de compra do passo 2 quando 60% dela aparece; volta a varrer só depois de sair de vista.
        // No desktop esse celular fica escondido e nunca cruza a tela.
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var tel = lis[1].querySelector('.inline-phone');
        var io2 = new IntersectionObserver(function (es) {
          var e = es[0];
          if (e.intersectionRatio >= .59) tel.classList.add('lendo-tela');
          else if (!e.isIntersecting) tel.classList.remove('lendo-tela');
        }, { threshold: [0, .6] });
        io2.observe(tel);
      })();
    </script>
  </section>

  <section id="recursos">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="eyebrow">Recursos</span>
        <h2>O que a Despensa faz por você</h2>
      </div>
      <div class="bento" data-reveal-group>
        <article class="card b1">
          <div class="txt">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ic.lista} /></svg></span>
            <h3>Uma lista só para a casa toda</h3>
            <p>Todo mundo que mora junto vê e edita a mesma lista, em tempo real. Quem está no mercado marca o que já pegou.</p>
            <ul>
              <li>Itens agrupados por categoria, com quantidade e unidade.</li>
              <li>Várias listas: mercado, feira, farmácia, churrasco.</li>
              <li>Listas só suas, que mais ninguém da casa vê.</li>
            </ul>
          </div>
          <Phone nome="lista" alt="Lista Mercado da semana no app: item em aberto e itens já no carrinho, com o total estimado" />
        </article>
        <article class="card b2">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ic.preco} /></svg></span>
          <h3>Preços que contam uma história</h3>
          <p>Cada nota alimenta o histórico. Veja a tendência de cada produto e em qual mercado ele sai mais barato.</p>
          <ul>
            <li>Preço atual por produto e por mercado.</li>
            <li>Nomes de produtos já limpos, sem aquele código esquisito da nota.</li>
          </ul>
        </article>
        <article class="card b3">
          <div class="txt">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14v17l-2.3-1.5L14.3 21 12 19.5 9.7 21l-2.4-1.5L5 21zM9 9h6M9 13h6" /></svg></span>
            <h3>Suas compras, num só lugar</h3>
            <p>Veja quanto a casa gastou no mês, em quais mercados, e abra qualquer compra para conferir item por item.</p>
            <ul>
              <li>Gasto do mês e histórico de compras.</li>
              <li>Corrija nomes de mercados e itens quando quiser.</li>
            </ul>
          </div>
          <Phone platform="android" nome="compras" alt="Gastos no app, em um Android: total gasto no mês e para onde foi o dinheiro" />
        </article>
        <article class="card b4">
          <div class="txt">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M8 8l4-4 4 4M5 14v5h14v-5" /></svg></span>
            <h3>Convide só para uma lista</h3>
            <p>Precisa de ajuda numa compra, ou vai fazer um churrasco com a turma? Gere um código e convide uma pessoa para aquela lista, sem abrir o resto da casa.</p>
            <ul>
              <li>O código vale por 30 minutos e você aprova quem entra.</li>
              <li>Permissão só para ver ou também para editar.</li>
              <li>Quem é convidado não vê as compras, os preços nem os outros itens da casa.</li>
            </ul>
          </div>
          <Phone nome="casa" alt="Casa no app, aberta pela aba Você: as pessoas da casa e o convite" />
        </article>
      </div>
    </div>
  </section>

  {/* Privacidade (M10): a faixa de tinta. No celular, a demonstração vem logo depois da promessa; no desktop, ao lado do texto. */}
  <section class="priv" id="privacidade-resumo" aria-labelledby="priv-h">
    <div class="wrap priv-grid">
      <div class="priv-cab">
        <span class="eyebrow">Privacidade</span>
        <h2 id="priv-h">Nunca guardamos <em>o&nbsp;CPF.</em></h2>
        <p class="sub">{cola('Ele aparece na nota fiscal e é descartado na leitura. Não fica no seu celular, na nuvem nem em registros técnicos.')}</p>
      </div>
      <div class="priv-nota">
        <Nota trecho />
        <p class="legend">{cola('A tarja é de verdade: o dado some na leitura.')}</p>
      </div>
      <div class="priv-mais">
        <ul class="priv-lista">
          {promessas.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.ic} /></svg>
              <span><b>{cola(p.t)}</b> {cola(p.d)}</span>
            </li>
          ))}
        </ul>
        <p class="after">Veja a <a href="/privacidade">Política de Privacidade</a>.</p>
      </div>
    </div>
  </section>

  <section id="planos">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="eyebrow">Planos</span>
        <h2>Comece de graça</h2>
      </div>
      <div class="plans" style="margin-top:0" data-reveal-group>
        <div class="card plan">
          <h3>Grátis para começar</h3>
          <p class="price-big">R$ 0</p>
          <p class="muted" style="margin:0">Baixe e comece a usar sem pagar nada: lista da casa, convites, leitura de notas e exportação em CSV.</p>
        </div>
        <div class="card plan full">
          <span class="pill sm">Em breve</span>
          <h3 style="margin-top:8px">Plano completo</h3>
          <p class="price-big"><small>a partir de </small>R$ 6,00<small> por mês</small></p>
          <p class="muted" style="margin:0">Histórico de preços completo, comparação entre mercados com gráficos, mais listas, pessoas e convidados. No plano anual.</p>
        </div>
      </div>
      <p style="margin:12px 0 0"><a class="link-btn" href="/planos">Ver planos e preços</a></p>
    </div>
  </section>

  <section id="perguntas" style="padding-top:0">
    <div class="wrap faq-wrap" data-reveal>
      <span class="eyebrow">Perguntas</span>
      <h2>Perguntas rápidas</h2>
      {perguntas.map(([q, a]) => (
        <details class="q" name="faq">
          <summary>{q}</summary>
          {a ? <p>{cola(a)}</p> : <p>Você começa de graça. Haverá um plano completo opcional. Veja os valores em <a href="/planos">planos e preços</a>.</p>}
        </details>
      ))}
    </div>
  </section>

  <section class="cta-sec">
    <div class="wrap">
      <div class="cta-card" data-reveal>
        <div class="cta-mark" aria-hidden="true"><Glyph /></div>
        <h2>Leve a Despensa para o mercado.</h2>
        <StoreButtons center />
      </div>
    </div>
  </section>
</Base>
